# AnxietyWatch ML - Environment Configuration
# Copy to .env and adjust as needed

# Random seed for reproducibility
RANDOM_SEED=42

# Logging level
LOG_LEVEL=INFO

# Data configuration
DATA_WINDOW_SIZE_SECONDS=60
DATA_WINDOW_STRIDE_SECONDS=30

# Model configuration
MODEL_TYPE=baseline

# Inference service (serving)
# Path (absolute or relative) to the trained AnxietyWatch bundle (.pkl).
ANXIETYWATCH_MODEL_PATH=models/prototype_v0.1.0.pkl
# When "true", startup FAILS if the artifact cannot be loaded (production).
# Leave unset (or "false") for local development to start degraded instead.
ANXIETYWATCH_REQUIRE_MODEL=true
# HTTP port the ASGI server binds to (Container Apps sets PORT).
PORT=8000