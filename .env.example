# AnxietyWatch ML - Environment Configuration
# Copy to .env and adjust as needed

# Random seed for reproducibility
RANDOM_SEED=42

# Logging level
LOG_LEVEL=INFO

# Data configuration
DATA_WINDOW_SIZE_SECONDS=60
DATA_WINDOW_STRIDE_SECONDS=30

# Model configuration
MODEL_TYPE=baseline

# Inference service (serving)
# Path (absolute or relative) to the trained AnxietyWatch bundle (.pkl).
ANXIETYWATCH_MODEL_PATH=models/prototype_v0.1.0.pkl
# When "true", startup FAILS if the artifact cannot be loaded (production).
# Leave unset (or "false") for local development to start degraded instead.
ANXIETYWATCH_REQUIRE_MODEL=true
# API key required by the inference endpoints (X-Api-Key header).
# Leave EMPTY (unset) in source control; set the real value as an Azure
# Container Apps secret (ANXIETYWATCH_API_KEY). If this is not configured the
# inference endpoints respond 503 instead of becoming public. /health is exempt.
ANXIETYWATCH_API_KEY=
# HTTP port the ASGI server binds to (configured as 8000 for the current deployment).
PORT=8000